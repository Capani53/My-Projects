@model List<HiFiModel> 
<div class="content-wrapper">    
    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1 class="m-0">HiFi Sil</h1>
                </div>
            </div>
        </div>
    </div>    
    <section class="content">
        <div class="container-fluid">            
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger">
                                    @TempData["Error"]
                                </div>
                            }
                            <table id="data-table" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Id</th>
                                        <th>Resim</th>
                                        <th>Ad</th>
                                        <th>Anasayfa</th>
                                        <th>Stok</th>
                                        <th>Marka</th>
                                        <th>#</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var hiFi in Model)
                                    {
                                        <tr>
                                            <td>@hiFi.Id</td>
                                            <td>
                                                <img src="http://localhost:5500/@hiFi.ImageUrl" width="25" />
                                            </td>
                                            <td>@hiFi.Name</td>
                                            <td>@hiFi.IsHome</td>
                                            <td>@hiFi.Stock</td>
                                            <td>@hiFi.Brand.Name</td>
                                            <td>
                                                <a class="btn btn-danger btn-sm"
                                                   asp-area="Admin"
                                                   asp-controller="HiFi"
                                                   asp-action="Delete"
                                                   asp-route-id="@hiFi.Id"
                                                   onclick="return confirm('HiFi ürününü silmek istediğinize emin misiniz?')">Sil</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>                        
                    </div>
                </div>
            </div>            
        </div>
    </section>   
</div>
@section Css{
    @await Html.PartialAsync("_DataTablesCssPartial")
}
@section Js{
    @await Html.PartialAsync("_DataTablesJsPartial")
}
