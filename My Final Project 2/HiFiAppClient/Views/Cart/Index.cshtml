@model CartViewModel
@using System.Linq
<section class="shop-cart spad">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="shop__cart__table">
                    <table>
                        <thead>
                            <tr>
                                <th>HiFi</th>
                                <th>Fiyat</th>
                                <th>Adet</th>
                                <th>Toplam</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartItems)
                            {
                                <tr>
                                    <td class="cart__product__item">
                                        <img src="http://localhost:5500/@item.HiFi.ImageUrl" alt="" width="50">
                                        <div class="cart__product__item__title">
                                            <h6>@item.HiFi.Name</h6>
                                            <div class="rating">
                                                <i class="fa fa-star"></i>
                                                <i class="fa fa-star"></i>
                                                <i class="fa fa-star"></i>
                                                <i class="fa fa-star"></i>
                                                <i class="fa fa-star"></i>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="cart__price">@item.HiFi.Price.ToString("C2")</td>
                                    <td class="cart__quantity">
                                        <div style="display: flex; align-items: center; justify-content: center;">
                                            <form asp-action="ChangeQuantity" method="post" style="display:inline;">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                <button type="submit" style="border:none; background:none; font-size: 20px; cursor: pointer;" @(item.Quantity <= 1 ? "disabled" : "")>-</button>
                                            </form>
                                            <span style="margin: 0 10px; font-weight: bold;">@item.Quantity</span>
                                            <form asp-action="ChangeQuantity" method="post" style="display:inline;">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                <button type="submit" style="border:none; background:none; font-size: 20px; cursor: pointer;">+</button>
                                            </form>
                                        </div>
                                    </td>
                                    <td class="cart__total">@((item.HiFi.Price * item.Quantity).ToString("C2"))</td>
                                    <td class="cart__close">
                                        <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                            <input type="hidden" name="cartItemId" value="@item.Id" />
                                            <button type="submit" style="background:none; border:none; padding:0; cursor:pointer;"><span class="icon_close"></span></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6 col-md-6 col-sm-6">
                <div class="cart__btn">
                    <a asp-controller="Home" asp-action="Index">ALIŞVERİŞE DEVAM ET</a>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-sm-6">
                <div class="cart__btn update__btn">
                    <a href="#"><span class="icon_loading"></span> SEPETİ GÜNCELLE</a>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="discount__content">
                    <h6>İNDİRİM KUPONLARI</h6>
                    <form action="#">
                        <input type="text" placeholder="KUPON KODUNUZU GİRİN">
                        <button type="submit" class="site-btn">Apply</button>
                    </form>
                </div>
            </div>
            <div class="col-lg-4 offset-lg-2">
                <div class="cart__total__procced">
                    <h6>SEPET TOPLAMI</h6>
                    <ul>
                        <li>ARA TOPLAM <span>@Model.CartItems.Sum(x => x.HiFi.Price * x.Quantity).ToString("C2")</span></li>
                        <li>TOPLAM <span>@Model.CartItems.Sum(x => x.HiFi.Price * x.Quantity).ToString("C2")</span></li>
                    </ul>
                    <form asp-action="Checkout" method="post">
                        <button type="submit" class="primary-btn" style="border:none; width:100%;">SEPETİ ONAYLA</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
